cabal-version:      3.0
name:               network-light
version:            0.1.0.4
synopsis:           A slimmed down version of network
description:        A slimmed down version of network, less capable and portable.
license:            Apache-2.0
license-file:       LICENSE
author:             Robert Krook
maintainer:         robert@krook.dev
copyright:          2025 Robert Krook
category:           Network
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

flag zephyr
  description: Use the Zephyr RTOS sockaddr_in ABI
  default: False
  manual:  True

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  System.Network.Types
                   ,  System.Network
    -- other-modules:
    -- other-extensions:
    if flag(zephyr)
        cpp-options: -DZEPHYR
    build-depends:    base >=4.14 && <5, bytestring
    hs-source-dirs:   src
    default-language: Haskell2010

Test-Suite test-sockaddr-storable
    type: exitcode-stdio-1.0
    Default-language: Haskell2010
    hs-source-dirs: test/Network
    main-is: SockAddr.hs
    build-depends: base, network-light, QuickCheck
